# ============================================
# Variables de Entorno de GitHub
# ============================================
#
# Para configurar en GitHub:
# 1. Ve a tu repositorio en GitHub
# 2. Settings > Secrets and variables > Actions
# 3. Click en "New repository secret"
# 4. Añade cada una de estas variables:
#
# Nombre del Secret en GitHub: GOOGLE_API_KEY
# Descripción: Tu API Key de Google Cloud Console
# Cómo obtenerla: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=tu_api_key_de_google_cloud

# Nombre del Secret en GitHub: SPREADSHEET_ID
# Descripción: El ID de tu Google Spreadsheet
# Lo encuentras en la URL: https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
SPREADSHEET_ID=tu_spreadsheet_id

# ============================================
# Para Desarrollo Local
# ============================================
#
# 1. Copia config.example.js como config.js
# 2. Edita config.js y reemplaza los valores
# 3. NO subas config.js a git (está en .gitignore)
